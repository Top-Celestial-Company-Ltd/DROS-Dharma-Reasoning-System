# DROS GitIgnore Configuration

# Python cache & compiled binaries
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Local Environment Variables & API Keys
.env
.env.local
.env.*.local

# Logs and execution metrics
logs/
*.log
proxy.log
proxy_error.log
v7_run.log

# System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Obsidian local configurations (excluding templates)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/backups/
.obsidian/plugins/hotkeys.json
.obsidian/plugins/dros-doctrinal-copilot/data.json
*.local.json
.env*
.knowledge_bridge_cache.pkl

# Exclude obsolete historical documents from GitHub uploads
docs/archive/

# Large files exceeding GitHub's 100MB limit
*.pdf
zhii_para_map.json
deleted_nodes_manifest.json

# Local scripture vault (exclude scripture contents, keep folder and mounting guide)
Vault_DajueZang/*
!Vault_DajueZang/READ_ME_大覺藏原典掛載指南.md
!Vault_DajueZang/大覺藏存放說明.md
.graphify_cache.pkl
.smtcmp_vector_db.tar.gz
push_release.bat

# Exclude Developer Tools, Pipelines & Staging (Vault-Only Repository)
inbox/
proxy/
scripts/
specs/
src/
tools/
*.py
*.bat
*.sh
*.ps1
pyproject.toml
requirements.txt
MANIFEST.in

# Confidential & Proprietary IP Protections
*confidential*
*Confidential*
*proprietary*
*PROPRIETARY*
*.secret
*.key
*.pem

